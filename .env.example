SECRET_KEY=change-me-use-a-long-random-string
ADMIN_PASSWORD=change-me-admin

# Optional — LLM relevance scoring
GEMINI_API_KEY=

# Optional — RSS feeds (comma-separated, default: BBC News)
RSS_FEED_URLS=https://feeds.bbci.co.uk/news/rss.xml

# Optional — Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional — Slack notifications
SLACK_BOT_TOKEN=

# Database and Redis (defaults match docker-compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/alertdb
REDIS_URL=redis://redis:6379/0
